{
  "poll_interval_seconds": 1.5,
  "popup_seconds": 5,
  "popup_width": 390,
  "popup_height": 104,
  "popup_margin_top": 20,
  "popup_margin_right": 20,
  "popup_corner_radius": 18,
  "popup_opacity": 0.92,
  "remind_while_unread_seconds": 30,
  "notification_cooldown_seconds": 8,
  "notify_on_existing_unread": true,
  "app_title_keywords": ["微信", "WeChat"],
  "macos_process_names": ["WeChat", "微信"],
  "macos_dock_names": ["WeChat", "微信", "微信的副本"],
  "enable_macos_dock_badge": true,
  "enable_macos_visual_badge": true,
  "enable_macos_dock_visual_badge": true,
  "enable_windows_notification_listener": true,
  "show_sender": false,
  "play_sound": false,
  "enable_startup": false,
  "debug_log": false,
  "debug_log_path": "",
  "max_pending_popups": 3,
  "sender_detection": "notification_banner_ocr",
  "notification_banner_region_width": 560,
  "notification_banner_region_height": 220,
  "notification_banner_top_margin": 24,
  "visual_red_pixel_threshold": 40,
  "dock_visual_light_pixel_threshold": 25,
  "notification_backend": "tk",
  "whitelist_sources": [],
  "whitelist_keywords": []
}
